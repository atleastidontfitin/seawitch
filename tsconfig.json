{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "rootDir": "."
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "test/**/*.d.ts", "examples/classifyNumber/predicates.ts", "examples/classifyNumber/types.ts"]
}
